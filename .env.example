# Copy to .env.local and fill in. .env.local is gitignored — never commit it.

# you.com API key, from https://you.com/platform. Needed for every lookup.
YDC_API_KEY=<YDC_API_KEY>

# Encrypts the stored Luma login ("Connect Luma"). Generate your own:
#   openssl rand -hex 32
SESSION_SECRET=<SESSION_SECRET>
