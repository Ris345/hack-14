# Copy to .env.local and fill in. .env.local is gitignored — never commit it.

# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>

# Signs the session cookie. Generate your own: openssl rand -hex 32
SESSION_SECRET=<SESSION_SECRET>

# Public origin of this app. Must match the Google redirect URI's origin.
APP_URL=http://localhost:3000

# you.com Web Search API key, from https://you.com/platform.
YDC_API_KEY=<YDC_API_KEY>
